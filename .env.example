# Firebase settings for online duels. Copy this file to .env.local and fill in the values from
# Firebase console -> Realtime Database (the address at the top of the Data tab) and Project settings.
# Without them, duels still work between tabs of one browser (handy for testing).
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
# Optional - duels don't need them. GitHub flags the API key as a leak once it is published,
# even though Firebase web keys are not secret, so it is simpler to leave these out.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
